{
  "manifest_version": 3,
  "name": "Password Vault",
  "version": "1.0.0",
  "description": "Secure password manager with autofill",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/autofill.ts-D3Sji3fA.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/autofill.ts-D3Sji3fA.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
