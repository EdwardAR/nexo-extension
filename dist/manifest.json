{
  "manifest_version": 3,
  "name": "Nexo",
  "version": "1.19.0",
  "description": "Tu centro digital para contraseñas y alertas",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "notifications",
    "alarms",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/autofill.ts-loader-CI2jIOuv.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "public/icons/icon-source.svg",
        "assets/floating-clock-CeoaKat2.js",
        "assets/timezones-vgLoi8w3.js",
        "assets/autofill.ts-DOe-aI5U.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
